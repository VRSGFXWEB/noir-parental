<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lokasi -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Senter (kontrol torch via CameraManager tidak butuh izin CAMERA) -->
    <uses-permission android:name="android.permission.FLASHLIGHT"/>

    <!-- Foreground service agar app tidak mati sendiri -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>

    <!-- Dibutuhkan untuk mod-menu/FPS overlay (fitur game booster, murni kosmetik) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Screenshot & screen record (lewat dialog izin resmi Android, wajib approve tiap sesi) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <!-- Supaya bisa baca daftar aplikasi/game yang terinstall -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <!-- CATATAN: tidak ada android.permission.CAMERA untuk akses kamera foto/video.
         FLASHLIGHT permission di atas hanya untuk kontrol LED senter, bukan kamera. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ParentalControl">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".PermissionSetupActivity"
            android:exported="false"/>

        <activity
            android:name=".GameLibraryActivity"
            android:exported="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="false"/>

        <activity
            android:name=".ScreenCaptureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>

        <activity
            android:name=".WallpaperApprovalActivity"
            android:exported="false"
            android:theme="@style/Theme.ParentalControl"/>

        <service
            android:name=".ControlForegroundService"
            android:foregroundServiceType="location"
            android:exported="false"/>

        <service
            android:name=".FpsOverlayService"
            android:exported="false"/>

        <service
            android:name=".ModMenuOverlayService"
            android:exported="false"/>

        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

        <receiver
            android:name=".UninstallProtectionReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
